NODE_ENV=production

# Self-hosted authentication
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=https://meet.example.com

# PostgreSQL (self-hosted or any compatible provider)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# LiveKit
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
NEXT_PUBLIC_LIVEKIT_URL=wss://replace_me
# Server-side LiveKit API endpoint. For LiveKit Cloud this is normally the
# HTTPS form of NEXT_PUBLIC_LIVEKIT_URL. Required for host "end for everyone".
LIVEKIT_URL=https://replace_me

# Optional: only needed if you reconnect archived backend APIs later.
NEXT_PUBLIC_API_URL=
