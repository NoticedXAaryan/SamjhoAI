NODE_ENV=development

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Database (Neon Postgres)
# Put your real Neon connection string in .env.local (never commit it).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# LiveKit credentials
LIVEKIT_API_KEY=lk_test_replace_me
LIVEKIT_API_SECRET=lk_test_replace_me
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server

# Optional: only needed if you reconnect archived backend APIs later.
NEXT_PUBLIC_API_URL=
