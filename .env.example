NODE_ENV=development

# Self-hosted authentication
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
# Optional separate signing secret for room-scoped guest sessions. When omitted,
# BETTER_AUTH_SECRET is used.
GUEST_SESSION_SECRET=replace_with_at_least_32_random_characters

# PostgreSQL (self-hosted or any compatible provider)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# LiveKit credentials
LIVEKIT_API_KEY=lk_test_replace_me
LIVEKIT_API_SECRET=lk_test_replace_me
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server
LIVEKIT_URL=https://your-livekit-server

# Optional: only needed if you reconnect archived backend APIs later.
NEXT_PUBLIC_API_URL=
